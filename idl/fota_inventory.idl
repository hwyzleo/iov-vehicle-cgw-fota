// =============================================================================
// idl/fota_inventory.idl - CGW-FOTA Provider 业务接口定义 (CGW-FOTA-DSN-CR-007)
// =============================================================================
// FOTA Provider 对 TBOX-TSP 暴露的唯一业务 Method。framework 只传递
// PayloadView/Buffer，不解析业务对象、不修改 wire；codec 所有权归 FOTA。
//
// 寻址（SSOT = 整车 SOME/IP Service Registry，过渡期由 constants.h 供给）：
//   Service  0x1120 / Instance 0x0001 / TCP 51120
//   Method   0x0001  METHOD_REQUEST_SOFTWARE_INVENTORY
//
// 接口版本：major=1, minor=0。
//   - major 不兼容进入 VersionMismatch (CGW-FW-0304)，fail-closed。
//   - minor 兼容只按 IDL 规则执行；optional metadata 向后兼容演进。
//
// Wire 编码（big-endian, 显式字段，不依赖 C 字符串终结符）：
//   RequestSoftwareInventoryRequest {
//     uint8  schemaVersion        // =1
//     uint16 requestIdLen;  bytes requestId[requestIdLen]
//     uint16 reasonLen;     bytes reason[reasonLen]
//     uint8  hasMetadata           // 0|1
//     if hasMetadata:
//       uint16 traceIdLen;  bytes traceId[traceIdLen]
//       uint16 callerLen;   bytes caller[callerLen]
//       uint8  metadataSchemaVersion
//   }
//
//   RequestSoftwareInventoryResponse {
//     uint8  schemaVersion        // =1
//     uint8  accepted             // 0|1
//     uint64 reportId             // big-endian
//     uint8  hasError             // 0|1
//     if hasError:
//       uint16 errorCodeLen; bytes errorCode[errorCodeLen]
//       uint16 errorMsgLen;  bytes errorMsg[errorMsgLen]
//   }
//
// trace metadata 作为 optional、向后兼容字段演进；对端未升级时以
// requestId/reportId 和 SOME/IP session 建立阶段性关联，不私占未登记
// Method/Event ID。
// =============================================================================
interface FotaInventory {
    version { major 1; minor 0; }

    method 0x0001 REQUEST_SOFTWARE_INVENTORY {
        request  RequestSoftwareInventoryRequest;
        response RequestSoftwareInventoryResponse;
    };
};
